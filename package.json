    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.6",
    "eslint": "9.13.0",
    "pino-pretty": "11.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.12.2",
    "vitest": "^2.1.4"
